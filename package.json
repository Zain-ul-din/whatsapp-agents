{
  "name": "whatsapp-agents",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite-node ./src/index.ts",
    "start": "vite-node ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ./src ./tests",
    "format:check": "prettier --check ./src ./tests",
    "test:harness": "vite-node ./tests/harness.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@hapi/boom": "^10.0.1",
    "@toon-format/toon": "^4.1.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "ai": "^7.0.127",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.0.3",
    "exa-js": "^2.25.0",
    "libphonenumber-js": "^1.13.17",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite-node": "^3.0.0",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
