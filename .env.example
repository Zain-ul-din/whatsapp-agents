# OpenAI (ChatGPT subscription) credentials
CHATGPT_ACCOUNT_ID=
OPENAI_OAUTH_ACCESS_TOKEN=

# Exa web search tool
EXA_API_KEY=

# PII guard
# Detection service for names/addresses (optional; without it only pattern matching runs)
PII_DETECTOR_URL=http://localhost:8000
PII_DETECTOR_TIMEOUT_MS=5000
# Country used to read local phone numbers (ISO code)
PII_DEFAULT_COUNTRY=PK
# 64 hex chars (openssl rand -hex 32). If unset, a key is generated in stores/pii-vault.key
PII_VAULT_KEY=
